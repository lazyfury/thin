[
  {
    "id": "rust-target",
    "name": "Rust 编译产物 (target/)",
    "category": "dev-cache",
    "risk": "safe",
    "regenerable": true,
    "sudo": false,
    "matcher": {
      "kind": "findDir",
      "roots": ["~/Documents", "~/Developer", "~/Projects", "~/code", "~/src"],
      "dirName": "target",
      "requireSibling": "Cargo.toml",
      "maxDepth": 6
    },
    "reclaim": "cd <项目> && cargo clean",
    "explain": {
      "what": "Rust 编译产生的中间文件与可执行文件",
      "cost": "删除后下次编译需重新构建，耗时变长",
      "recover": "重新编译即可，无需从备份恢复"
    }
  },
  {
