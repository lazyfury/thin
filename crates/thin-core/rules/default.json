  {
    "id": "downloads-installers",
    "name": "下载的安装包/压缩包 (~/Downloads)",
    "category": "other",
    "risk": "confirm",
    "regenerable": false,
    "sudo": false,
    "matcher": {
      "kind": "findFile",
      "roots": [
        "~/Downloads"
      ],
      "extensions": [
        "dmg",
        "pkg",
        "mpkg",
        "iso",
        "xip",
        "zip",
        "tar.gz",
        "tgz",
        "7z",
        "rar"
      ],
      "maxDepth": 3,
      "minSize": 10485760
    },
    "reclaim": "确认已安装/已解压后，移入废纸篓或 thin 隔离区（可恢复）",
    "explain": {
      "what": "下载目录里的安装包与压缩包（.dmg/.pkg/.zip/.tar.gz 等，默认只列 ≥10MB）",
      "cost": "多为一次性的安装/解压素材；删后如需再用需重新下载",
      "recover": "从原来源重新下载；重要内容请先解压或移到别处"
    }
  },
